# Copy to .env and fill in. Never commit the real .env.

# Live mode needs BOTH of these. Without them the app runs in offline preview
# (keyword search + SQLite, no model calls).
OPENAI_API_KEY=
DEMO_PASSWORD=

OPENAI_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
ENABLE_EMBEDDINGS=true

# In-app spending guard. This is an estimate based on the rates below, so also
# set a usage limit in the OpenAI dashboard.
MAX_ESTIMATED_SPEND_USD=3
INPUT_USD_PER_MILLION=0.40
OUTPUT_USD_PER_MILLION=1.60

MAX_API_REQUESTS_PER_HOUR=35
MAX_TOOL_ROUNDS=4
ENABLE_SDK_TRACING=false
